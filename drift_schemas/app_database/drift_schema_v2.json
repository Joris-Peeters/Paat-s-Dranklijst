          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"user_id\" INTEGER NOT NULL REFERENCES users (id), \"type\" TEXT NOT NULL, \"amount_minor_units\" INTEGER NOT NULL, \"quantity\" INTEGER NOT NULL DEFAULT 1, \"item_id\" INTEGER NULL REFERENCES items (id), \"item_name_snapshot\" TEXT NULL, \"item_unit_price_snapshot\" INTEGER NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"logical_date\" TEXT NOT NULL, \"voided_at\" INTEGER NULL, \"voided_note\" TEXT NULL, \"confirmed_at\" INTEGER NULL, CHECK (quantity > 0));"
        }
      ]
    },
    {
      "name": "user_balances",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE VIEW IF NOT EXISTS \"user_balances\" (\"user_id\", \"balance_minor_units\") AS SELECT \"t0\".\"user_id\" AS \"user_id\", SUM(\"t0\".\"amount_minor_units\") AS \"balance_minor_units\" FROM \"transactions\" \"t0\" WHERE \"t0\".\"voided_at\" IS NULL GROUP BY \"t0\".\"user_id\""
        }
      ]
